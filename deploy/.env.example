# Server settings: /opt/crm/prod/.env, mode 600. Never commit real values.

# PostgreSQL in Docker (docker compose project "prod")
POSTGRES_USER=
# Letters and digits only: it becomes part of the connection URL.
# Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
OWNER_EMAIL=