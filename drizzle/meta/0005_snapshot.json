        "contacts_contact_frequency_check": {
          "name": "contacts_contact_frequency_check",
          "value": "\"contacts\".\"contact_frequency\" in ('week', 'month', 'quarter', 'year')"
        },
        "contacts_birthday_check": {
          "name": "contacts_birthday_check",
          "value": "(\"contacts\".\"birthday_day\" is null and \"contacts\".\"birthday_month\" is null) or (\"contacts\".\"birthday_day\" is not null and \"contacts\".\"birthday_month\" is not null and \"contacts\".\"birthday_month\" between 1 and 12 and \"contacts\".\"birthday_day\" between 1 and (case \"contacts\".\"birthday_month\" when 2 then 29 when 4 then 30 when 6 then 30 when 9 then 30 when 11 then 30 else 31 end))"
        },
        "contacts_birthday_year_check": {
          "name": "contacts_birthday_year_check",
          "value": "\"contacts\".\"birthday_year\" is null or \"contacts\".\"birthday_day\" is not null"
        }
      },
